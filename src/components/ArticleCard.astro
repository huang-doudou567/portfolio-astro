---
interface Props {
  title: string;
  excerpt: string;
  category: string;
  date: string;
  readTime: string;
  slug: string;
  size?: 'small' | 'medium';
}

const { title, excerpt, category, date, readTime, slug, size = 'medium' } = Astro.props;
const excerptText = excerpt.length > 100 ? excerpt.slice(0, 100) + '…' : excerpt;
---

<a
  href={`/thinking/${slug}`}
  class:list={[
    'group card-hover block rounded-sm overflow-hidden border border-blueprint-500/10 bg-white/90 transition-all',
    size === 'small' ? 'p-4' : 'p-5'
  ]}
>
  <!-- 顶栏：分类 + 日期 -->
  <div class="flex items-center justify-between mb-2">
    <span class="text-[9px] font-mono-code px-1.5 py-0.5 rounded-sm bg-blueprint-500/10 text-blueprint-600 border border-blueprint-500/20 whitespace-nowrap">
      {category}
    </span>
    <div class="flex items-center gap-2 text-[9px] text-charcoal-800/50 font-mono-code">
      <span>{date}</span>
      <span class="hidden sm:inline">· {readTime}</span>
    </div>
  </div>

  <!-- 标题 -->
  <h3 class:list={[
    'font-serif-display font-bold text-charcoal-900 group-hover:text-blueprint-500 transition-colors',
    size === 'small' ? 'text-sm' : 'text-base'
  ]}>
    {title}
  </h3>

  <!-- 摘要 -->
  <p class="text-xs text-charcoal-800/70 leading-relaxed mt-1.5 mb-3">
    {excerptText}
  </p>

  <!-- 阅读 CTA — 始终可见 -->
  <div class="flex items-center justify-between pt-2 border-t border-blueprint-500/10">
    <span class="text-[9px] text-charcoal-800/40 font-mono-code sm:hidden">
      {readTime}
    </span>
    <span class="flex items-center text-[10px] text-blueprint-500 font-mono-code ml-auto transition-all group-hover:opacity-100">
      <span class="border-b border-blueprint-500/30">阅读</span>
      <svg class="w-3 h-3 ml-0.5 transform group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
      </svg>
    </span>
  </div>
</a>
