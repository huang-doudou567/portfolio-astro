---
// 导航栏组件
const siteName = import.meta.env.PUBLIC_NAME;

const navItems = [
  { label: '首页', href: '/' },
  { label: '项目', href: '/projects' },
  { label: '思考', href: '/thinking' },
  { label: '关于我', href: '/about' },
  { label: '联系', href: '/contact' },
];

const currentPath = Astro.url.pathname;
---

<nav class="fixed top-0 left-0 right-0 z-50 backdrop-blur-md bg-cream-100/80 dark:bg-dark-bg-950/80 border-b border-charcoal-900/10 dark:border-cream-100/10 transition-all duration-300">
  <div class="max-w-7xl mx-auto px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <!-- Logo -->
      <a href="/" class="flex items-center space-x-2 group">
        <span class="font-serif-display text-xl font-bold text-charcoal-900 dark:text-cream-100 group-hover:text-ochre-500 transition-colors">
          {siteName}
        </span>
        <span class="text-xs text-charcoal-800/60 dark:text-cream-100/60 font-mono-code hidden sm:inline">
          / ai-pm
        </span>
      </a>
      
      <!-- Desktop Navigation -->
      <div class="hidden md:flex items-center space-x-1">
        {navItems.map((item) => {
          const isActive = currentPath === item.href || 
            (item.href !== '/' && currentPath.startsWith(item.href));
          return (
            <a
              href={item.href}
              class:list={[
                'px-4 py-2 text-sm font-medium rounded-md transition-all duration-200',
                isActive 
                  ? 'text-ochre-500 bg-ochre-500/10' 
                  : 'text-charcoal-800/80 dark:text-cream-100/80 hover:text-ochre-500 hover:bg-charcoal-900/5 dark:hover:bg-cream-100/5'
              ]}
            >
              {item.label}
            </a>
          );
        })}
      </div>
      
      <!-- Right side: Theme toggle + Resume button -->
      <div class="flex items-center space-x-3">
        <!-- Theme Toggle -->
        <button 
          onclick="toggleTheme()"
          class="p-2 rounded-md text-charcoal-800/70 dark:text-cream-100/70 hover:text-ochre-500 hover:bg-charcoal-900/5 dark:hover:bg-cream-100/5 transition-all"
          aria-label="切换主题"
        >
          <!-- Sun icon (light mode) -->
          <svg class="w-5 h-5 dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
          </svg>
          <!-- Moon icon (dark mode) -->
          <svg class="w-5 h-5 hidden dark:block" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
          </svg>
        </button>
        
        <!-- Resume Button -->
        <a 
          href="/resume.pdf" download 
          class="hidden sm:inline-flex items-center px-4 py-2 text-sm font-medium bg-ochre-500 text-white rounded-md hover:bg-ochre-600 transition-all hover:-translate-y-0.5 hover:shadow-lg hover:shadow-ochre-500/25"
        >
          <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          简历下载
        </a>
        
        <!-- Mobile menu button -->
        <button 
          id="mobile-menu-btn"
          class="md:hidden p-2 rounded-md text-charcoal-800/70 dark:text-cream-100/70 hover:text-ochre-500"
          onclick="toggleMobileMenu()"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>
  </div>
  
  <!-- Mobile Menu -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-charcoal-900/10 dark:border-cream-100/10">
    <div class="px-4 py-3 space-y-1">
      {navItems.map((item) => {
        const isActive = currentPath === item.href || 
          (item.href !== '/' && currentPath.startsWith(item.href));
        return (
          <a
            href={item.href}
            class:list={[
              'block px-4 py-2 text-sm font-medium rounded-md transition-colors',
              isActive 
                ? 'text-ochre-500 bg-ochre-500/10' 
                : 'text-charcoal-800/80 dark:text-cream-100/80 hover:text-ochre-500 hover:bg-charcoal-900/5 dark:hover:bg-cream-100/5'
            ]}
          >
            {item.label}
          </a>
        );
      })}
      <a 
        href="/resume.pdf" download 
        class="block mt-3 text-center px-4 py-2 text-sm font-medium bg-ochre-500 text-white rounded-md"
      >
        简历下载
      </a>
    </div>
  </div>
</nav>

<!-- 导航栏占位 -->
<div class="h-16"></div>

<script is:inline>
  function toggleMobileMenu() {
    const menu = document.getElementById('mobile-menu');
    menu.classList.toggle('hidden');
  }
</script>
