---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Macintosh3D from '../components/Macintosh3D.astro';
import { projects } from '../data/projects';

const featuredProjects = projects.slice(0, 3);
const siteName = import.meta.env.PUBLIC_NAME;

const skillGroups = [
  { title: 'AI Coding', skills: ['Codex', 'Claude Code', 'Cursor'] },
  { title: '核心技术', skills: ['RAG', 'Prompt Engineering', 'Workflow 搭建', 'Agent 架构'] },
  { title: '平台能力', skills: ['Skill / Plugin', 'Rules 编写', 'MCP 接入', '模型评测'] },
  { title: '产品能力', skills: ['AI 产品需求设计', '迭代管理', '用户研究', '数据驱动决策'] },
];

const experiences = [{
  company: '闲鱼 · 交易产品组 · AI 方向',
  position: 'AI 产品实习生', period: '2024.08 – 2025.02',
  description: '负责 AI Agent 导购的产品设计与评测体系搭建。从单轮对话优化到多轮 Agent 评估，构建了完整的评测闭环，涵盖 Prompt 工程、专题库建设、Bad case 归因与全链路监控。优化后不良回复率降低 12%，高频问题应答覆盖率达 95%，意图识别率提升至 94%。',
  highlights: ['不良回复率 ↓12%', '应答覆盖率 95%', '意图识别率 94%', '高风险拦截率 98%'],
}];

const education = [
  { school: '湖南大学（双一流 985 211）', degree: '税务专业硕士', period: '2023.09 – 2025.06' },
  { school: '湖南农业大学', degree: '金融 CFA 本科', period: '2019.09 – 2023.06' },
];

const personalTags = ['Agent 项目落地', '从0到1搭建评测', 'C端+B端双栖', '全栈产品经理', '学术背景', 'AI 原生思维', '产品驱动技术', '结果导向'];
const awards = ['校一等奖学金', '优秀学生标兵', '优秀毕业生', 'CFA 金融分析大赛小组一等奖', '互联网+大学生创新创业大赛二等奖'];
const coreSkills = ['Agent 产品设计', 'AI 评测体系', 'Prompt Engineering', 'RAG 架构设计', '用户研究', '数据分析', '产品规划', '跨团队协作', '大模型应用', '多模态交互', '需求分析', '原型设计'];
---

<BaseLayout title="首页" description="AI产品经理个人作品集 - 用Agent思维解决真实问题">

  <!-- ============================================================ -->
  <!-- HERO — CAD / 切割垫风格                                      -->
  <!-- ============================================================ -->
  <section class="relative min-h-[85vh] flex items-center overflow-hidden">
    <!-- 装饰标注线 -->
    <div class="absolute top-8 left-6 lg:left-10 flex items-center text-[10px] font-mono-code text-blueprint-500/30 tracking-widest">
      <span class="w-8 h-px bg-blueprint-500/20 mr-2"></span>
      <span>DRAFTSMAN v2.4</span>
      <span class="mx-3 text-blueprint-500/10">|</span>
      <span class="text-blueprint-500/20">X:0 Y:0</span>
    </div>

    <!-- 右上角蓝图标注 -->
    <div class="absolute top-8 right-6 lg:right-10 flex flex-col items-end text-[10px] font-mono-code text-blueprint-500/20">
      <span>REF: LC-2026.06</span>
      <span>REV: 03</span>
      <span class="mt-1 flex items-center"><span class="status-dot online"></span> SYSTEM: NOMINAL</span>
    </div>

    <!-- 装饰角标（切割垫标记） -->
    <div class="absolute top-0 left-0 w-12 h-12 border-t-2 border-l-2 border-blueprint-500/15"></div>
    <div class="absolute top-0 right-0 w-12 h-12 border-t-2 border-r-2 border-blueprint-500/15"></div>
    <div class="absolute bottom-0 left-0 w-12 h-12 border-b-2 border-l-2 border-blueprint-500/15"></div>
    <div class="absolute bottom-0 right-0 w-12 h-12 border-b-2 border-r-2 border-blueprint-500/15"></div>

    <!-- 尺规装饰 — 顶部刻度 -->
    <div class="absolute top-16 left-16 right-16 h-4 overflow-hidden opacity-30 pointer-events-none select-none">
      <svg class="w-full h-full" viewBox="0 0 1200 16" preserveAspectRatio="none">
        {Array.from({length: 31}, (_, i) => (
          <g key={i}>
            <line x1={i*40} y1="0" x2={i*40} y2={i%5===0 ? '16' : i%2===0 ? '10' : '6'} stroke="#1E40AF" strokeWidth="0.5"/>
          </g>
        ))}
        {Array.from({length: 151}, (_, i) => (
          <line key={`s${i}`} x1={i*8} y1={i%5===0 ? '16' : i%2===0 ? '10' : '6'} x2={i*8} y2="16" stroke="#1E40AF" strokeWidth="0.3" opacity="0.5"/>
        ))}
      </svg>
    </div>

    <div class="max-w-7xl mx-auto px-6 lg:px-8 relative z-10 w-full pt-16 pb-16">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 lg:gap-20 items-center min-h-[70vh]">

        <!-- ========== Left: CAD Draftsman Text ========== -->
        <div class="space-y-8">
          <!-- 蓝图文件信息 -->
          <div class="flex items-center gap-3 text-[10px] font-mono-code text-blueprint-500/40">
            <span class="cad-badge text-[9px]">PRJ-001</span>
            <span>|</span>
            <span>SCALE 1:1</span>
            <span>|</span>
            <span>SHEET 01/05</span>
          </div>

          <!-- Avatar + Name — 头像在左，姓名在右（头像略大） -->
          <div class="flex items-center gap-5 lg:gap-7">
            <!-- 头像 -->
            <div class="flex-shrink-0">
              <div class="w-28 h-28 sm:w-32 sm:h-32 lg:w-36 lg:h-36 rounded-full border-2 border-blueprint-500/15 overflow-hidden bg-white shadow-lg shadow-blueprint-500/5">
                <img src="/images/头像.jpg" alt="黄可欣" class="w-full h-full object-contain" />
              </div>
            </div>
            <!-- 姓名 -->
            <div>
              <h1 class="font-serif-display text-5xl sm:text-6xl lg:text-7xl xl:text-8xl font-bold text-charcoal-900 leading-[0.9] tracking-[-0.03em]">
                <span class="block">黄可欣</span>
              </h1>
              <div class="flex items-center mt-3 lg:mt-4 space-x-4">
                <div class="w-12 h-px bg-blueprint-500/30"></div>
                <p class="font-mono-code text-sm tracking-[0.2em] text-blueprint-500/60 uppercase">AI Product Manager</p>
              </div>
            </div>
          </div>

          <!-- 参考信息 -->
          <div class="flex flex-wrap gap-4 text-xs font-mono-code">
            <span class="text-charcoal-800/40">REF: <span class="text-blueprint-500/60">LC-2025-006</span></span>
            <span class="text-charcoal-800/20">|</span>
            <span class="text-charcoal-800/40">REV: <span class="text-blueprint-500/60">03</span></span>
            <span class="text-charcoal-800/20">|</span>
            <span class="text-charcoal-800/40">DATE: <span class="text-blueprint-500/60">2026.06</span></span>
          </div>

          <!-- 信念 + 能力简述 -->
          <p class="text-sm text-charcoal-800/70 leading-relaxed max-w-lg">
            让 <span class="text-blueprint-500 font-medium">AI 理解人</span>，而不只是回答问题。<br>
            <span class="text-xs text-charcoal-800/40 italic block mt-2 font-serif-display">从 Agent 架构到评测体系 · C 端到 B 端</span>
          </p>

          <!-- CTA 按钮 — CAD 风格 -->
          <div class="flex flex-wrap gap-3">
            <a href="/projects" class="cad-btn cad-btn-primary text-xs tracking-wider">
              <svg class="w-3.5 h-3.5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
              </svg>
              查看项目作品
            </a>
            <a href="/contact" class="cad-btn cad-btn-secondary">联系我</a>
          </div>

          <!-- 数据指标 — CAD 风格 -->
          <div class="flex gap-8 pt-6 border-t border-blueprint-500/10">
            <div><div class="font-mono-code text-xl font-bold text-blueprint-500">3</div><div class="text-[11px] text-charcoal-800/40 font-mono-code mt-1">AI 项目</div></div>
            <div class="w-px bg-blueprint-500/10"></div>
            <div><div class="font-mono-code text-xl font-bold text-blueprint-500">1</div><div class="text-[11px] text-charcoal-800/40 font-mono-code mt-1">评测体系</div></div>
            <div class="w-px bg-blueprint-500/10"></div>
            <div><div class="font-mono-code text-xl font-bold text-blueprint-500">985</div><div class="text-[11px] text-charcoal-800/40 font-mono-code mt-1">硕士</div></div>
          </div>

          <!-- 使命宣言 — 角落 -->
          <div class="pt-2">
            <p class="text-[10px] font-mono-code text-blueprint-500/30 italic leading-relaxed max-w-xs border-l-2 border-blueprint-500/10 pl-3">
              "用 Agent 思维解决真实问题"
            </p>
          </div>
        </div>

        <!-- ========== Right: 3D Macintosh 128k ========== -->
        <div class="relative flex items-center justify-center py-4">
          <Macintosh3D />
        </div>
      </div>
    </div>

    <!-- 滚动提示 -->
    <div class="absolute bottom-6 left-1/2 -translate-x-1/2 flex flex-col items-center">
      <span class="text-[9px] font-mono-code text-blueprint-500/20 mb-1 tracking-widest">SCROLL</span>
      <svg class="w-4 h-4 text-blueprint-500/20 animate-bounce" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
      </svg>
    </div>
  </section>

  <!-- ====== 锚点导航 ====== -->
  <div class="sticky top-14 z-40 bg-blueprint-500/[0.03] border-b border-blueprint-500/10 backdrop-blur-sm">
    <div class="max-w-5xl mx-auto px-6 lg:px-8">
      <nav class="anchor-nav" aria-label="页面导航">
        <a href="#sec-about" class="anchor-nav-link">我</a>
        <a href="#sec-skills" class="anchor-nav-link">技能</a>
        <a href="#sec-experience" class="anchor-nav-link">经历</a>
        <a href="#sec-education" class="anchor-nav-link">教育</a>
        <a href="#sec-projects" class="anchor-nav-link">项目</a>
        <a href="#sec-core" class="anchor-nav-link">核心能力</a>
      </nav>
    </div>
  </div>

  <!-- ====== 精选项目（首屏） ====== -->
  <section id="sec-projects" class="section-anchor py-16 lg:py-20 bg-white/60">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="animate-on-scroll animate-fade-in-up mb-10">
        <div class="flex items-center gap-3 mb-4">
          <span class="cad-badge">PROJECTS</span>
          <span class="text-[10px] font-mono-code text-blueprint-500/30">— / 05</span>
          <div class="flex-1 h-px bg-blueprint-500/10"></div>
        </div>
        <h2 class="font-serif-display text-3xl font-bold text-charcoal-900">精选项目作品</h2>
        <p class="text-xs text-charcoal-800/50 mt-2 font-mono-code">从 C 端自我认知工具到 B 端电商决策系统。覆盖 Agent 架构、评测体系、RAG 搜索三大方向。</p>
      </div>

      <div class="cad-panel-solid overflow-hidden animate-on-scroll animate-fade-in-up">
        <div class="cad-titlebar">PROJECT REGISTER — ACTIVE PROJECTS</div>
        <div class="overflow-x-auto">
          <table class="cad-table">
            <thead>
              <tr>
                <th>REF</th>
                <th>项目名称</th>
                <th>分类</th>
                <th>状态</th>
                <th>时间</th>
                <th class="text-right">操作</th>
              </tr>
            </thead>
            <tbody>
              {projects.map((p, i) => (
                <tr class="cursor-pointer hover:bg-blueprint-500/[0.03]" onclick={`window.location='/projects/${p.slug}'`}>
                  <td class="font-mono-code text-blueprint-500/60">{`PRJ-${String(i + 1).padStart(3, '0')}`}</td>
                  <td class="font-medium text-charcoal-900">{p.title}</td>
                  <td><span class="text-[10px] px-1.5 py-0.5 rounded-sm bg-blueprint-500/10 text-blueprint-600 font-mono-code">{p.subtitle}</span></td>
                  <td><span class="flex items-center text-xs"><span class="status-dot online"></span> ACTIVE</span></td>
                  <td class="font-mono-code text-xs">{p.timeline}</td>
                  <td class="text-right">
                    <span class="text-[10px] text-blueprint-500/50 font-mono-code hover:text-blueprint-500 transition-colors">OPEN →</span>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>

      <div class="mt-6 text-center animate-on-scroll animate-fade-in-up">
        <a href="/projects" class="cad-btn cad-btn-secondary text-xs">
          查看全部项目 <span class="ml-1">→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ====== CAD 风格内容区 ====== -->

  <!-- 个人简介 — CAD Panel (折叠) -->
  <section id="sec-about" class="section-anchor py-8 lg:py-10">
    <div class="max-w-5xl mx-auto px-6 lg:px-8">
      <details class="cad-panel-solid animate-on-scroll animate-fade-in-up group" open>
        <summary class="p-6 lg:p-8 cursor-pointer list-none flex items-center justify-between select-none hover:bg-blueprint-500/[0.02] transition-colors">
          <div class="flex items-center gap-3">
            <span class="cad-badge">ABOUT</span>
            <span class="text-[10px] font-mono-code text-blueprint-500/30">01 / 05</span>
            <h2 class="font-serif-display text-2xl font-bold text-charcoal-900">个人简介</h2>
          </div>
          <svg class="w-4 h-4 text-blueprint-500/40 transition-transform duration-200 group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </summary>
        <div class="px-6 lg:px-8 pb-8 lg:pb-10 border-t border-blueprint-500/10 pt-6">
          <div class="flex flex-col lg:flex-row gap-10">
            <div class="lg:w-1/4">
              <h2 class="font-serif-display text-3xl font-bold text-charcoal-900 leading-[1.1]">黄可欣</h2>
              <p class="text-xs font-mono-code text-blueprint-500/50 mt-2">AI PRODUCT MANAGER</p>
              <div class="w-16 h-px bg-blueprint-500/20 mt-4"></div>
            </div>
            <div class="lg:w-3/4 space-y-4 text-sm text-charcoal-800/70 leading-relaxed">
              <p>专注 <strong class="text-blueprint-500">Agent 架构</strong>、AI 驱动的信息检索和用户侧 AI 产品设计。我相信"让 AI 理解人"比"让人适应 AI"更有价值——这也是我所有项目的出发点。</p>
              <p>从学术研究到产品落地，我习惯用结构化思维拆解问题。三个项目覆盖了 C 端自我认知、B 端电商决策、以及全场景的信息检索——它们共同的线索是：让 AI 不只是"回答问题"，而是真正理解用户所处的上下文。</p>
              <p class="text-blueprint-500/50 italic text-xs font-serif-display">湖南大学税务硕士，金融本科。校一等奖学金/优秀毕业生/CFA 金融分析大赛一等奖。</p>
            </div>
          </div>
        </div>
      </details>
    </div>
  </section>

  <!-- 技能栈 — CAD Panel Grid (折叠) -->
  <section id="sec-skills" class="section-anchor py-8 lg:py-10 bg-blueprint-500/[0.02]">
    <div class="max-w-5xl mx-auto px-6 lg:px-8">
      <details class="cad-panel-solid animate-on-scroll animate-fade-in-up group" open>
        <summary class="p-6 lg:p-8 cursor-pointer list-none flex items-center justify-between select-none hover:bg-blueprint-500/[0.02] transition-colors">
          <div class="flex items-center gap-3">
            <span class="cad-badge">CAPABILITIES</span>
            <span class="text-[10px] font-mono-code text-blueprint-500/30">02 / 05</span>
            <h2 class="font-serif-display text-2xl font-bold text-charcoal-900">技能栈</h2>
          </div>
          <svg class="w-4 h-4 text-blueprint-500/40 transition-transform duration-200 group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </summary>
        <div class="px-6 lg:px-8 pb-8 lg:pb-10 border-t border-blueprint-500/10 pt-6">
          <p class="text-xs text-charcoal-800/50 mb-6 font-mono-code">四组核心能力，构建完整的 AI 产品能力矩阵</p>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            {skillGroups.map((group, index) => (
              <div class={`animate-on-scroll animate-fade-in-up animate-delay-${index * 100}`}>
                <div class="cad-panel-solid p-6 h-full">
                  <div class="flex items-center justify-between mb-4">
                    <h3 class="font-mono-code text-xs font-semibold text-blueprint-500 tracking-wider uppercase">{group.title}</h3>
                    <span class="text-[10px] font-mono-code text-blueprint-500/30">SK-{String(index + 1).padStart(2, '0')}</span>
                  </div>
                  <div class="flex flex-wrap gap-2">
                    {group.skills.map((s) => (<span class="tag text-[11px]">{s}</span>))}
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </details>
    </div>
  </section>

  <!-- 实习经历 — CAD Timeline -->
  <section id="sec-experience" class="section-anchor py-16 lg:py-20">
    <div class="max-w-5xl mx-auto px-6 lg:px-8">
      <div class="animate-on-scroll animate-fade-in-up mb-10">
        <div class="flex items-center gap-3 mb-4">
          <span class="cad-badge">EXPERIENCE</span>
          <span class="text-[10px] font-mono-code text-blueprint-500/30">03 / 05</span>
          <div class="flex-1 h-px bg-blueprint-500/10"></div>
        </div>
        <h2 class="font-serif-display text-3xl font-bold text-charcoal-900">工作经历</h2>
      </div>
      <div class="space-y-6">
        {experiences.map((exp) => (
          <div class="animate-on-scroll animate-fade-in-up">
            <div class="cad-panel-solid p-6 lg:p-8 relative">
              <!-- 左侧时间线标记 -->
              <div class="absolute left-0 top-0 bottom-0 w-1 bg-blueprint-500/15"></div>
              <div class="absolute -left-[5px] top-8 w-3 h-3 rounded-full bg-blueprint-500 border-2 border-white"></div>

              <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between mb-4 ml-4">
                <div>
                  <h3 class="font-serif-display text-lg font-bold text-charcoal-900">{exp.position}</h3>
                  <p class="text-blueprint-500 font-medium text-sm font-mono-code">{exp.company}</p>
                </div>
                <span class="text-[10px] font-mono-code text-charcoal-800/40 mt-1 sm:mt-0 border border-blueprint-500/15 px-2 py-0.5 rounded-sm">{exp.period}</span>
              </div>
              <p class="text-sm text-charcoal-800/70 leading-relaxed mb-4 ml-4">{exp.description}</p>
              <div class="flex flex-wrap gap-2 ml-4">
                {exp.highlights.map((h) => (<span class="tag text-[11px]">{h}</span>))}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 教育 + 荣誉 — CAD Panels Side by Side -->
  <section id="sec-education" class="section-anchor py-16 lg:py-20 bg-blueprint-500/[0.02]">
    <div class="max-w-5xl mx-auto px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <!-- 教育 -->
        <div class="animate-on-scroll animate-fade-in-up">
          <div class="cad-panel-solid p-6">
            <div class="flex items-center gap-3 mb-6">
              <span class="cad-badge">EDUCATION</span>
              <span class="text-[10px] font-mono-code text-blueprint-500/30">04-A / 05</span>
              <div class="flex-1 h-px bg-blueprint-500/10"></div>
            </div>
            <div class="space-y-4">
              {education.map((edu) => (
                <div class="border-l-2 border-blueprint-500/15 pl-4 py-2 hover:border-blueprint-500/40 transition-colors">
                  <h3 class="font-serif-display text-base font-bold text-charcoal-900">{edu.school}</h3>
                  <p class="text-xs text-blueprint-500/70 font-mono-code mt-1">{edu.degree}</p>
                  <p class="text-[10px] text-charcoal-800/50 font-mono-code mt-1">{edu.period}</p>
                </div>
              ))}
            </div>
          </div>
        </div>

        <!-- 荣誉奖项 + 个人标签 -->
        <div class="animate-on-scroll animate-fade-in-up animate-delay-100">
          <div class="cad-panel-solid p-6">
            <div class="flex items-center gap-3 mb-6">
              <span class="cad-badge">AWARDS & TAGS</span>
              <span class="text-[10px] font-mono-code text-blueprint-500/30">04-B / 05</span>
              <div class="flex-1 h-px bg-blueprint-500/10"></div>
            </div>
            <h4 class="text-xs font-mono-code font-semibold text-charcoal-800/60 mb-3 tracking-wider uppercase">荣誉奖项</h4>
            <div class="flex flex-wrap gap-2 mb-6">
