<script is:inline>
  // Mac LED 面板同步 — 从全局鼠标追踪读取坐标
  (function() {
    function syncMacLED() {
      var ledX = document.getElementById('macLedX');
      var ledY = document.getElementById('macLedY');
      if (!ledX) return; // Mac 不在当前页面

      function padCoord(n) {
        return String(Math.max(0, Math.min(9999, Math.round(n)))).padStart(4, '0');
      }

      // 监听全局坐标事件
      window.addEventListener('mousemove-global', function(e) {
        var x = e.detail.x;
        var y = e.detail.y;
        if (ledX) ledX.textContent = 'X:' + padCoord(x);
        if (ledY) ledY.textContent = 'Y:' + padCoord(y);
      });

      // 兜底：直接读取 window.__mouseX
      setInterval(function() {
        if (window.__mouseX !== undefined) {
          if (ledX) ledX.textContent = 'X:' + padCoord(window.__mouseX);
          if (ledY) ledY.textContent = 'Y:' + padCoord(window.__mouseY);
        }
      }, 100);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', syncMacLED);
    } else {
      syncMacLED();
    }
  })();
</script>

