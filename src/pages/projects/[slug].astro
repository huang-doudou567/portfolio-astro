---
import BaseLayout from '../../layouts/BaseLayout.astro';
import StickyToc from '../../components/StickyToc.astro';
import { getProjectBySlug, getAdjacentProjects, projects } from '../../data/projects';
import { articles } from '../../data/articles';

// 手动关联：文章正文明确引用/讨论了特定项目
const MANUAL_CROSSLINKS: Record<string, string[]> = {
  'tax-policy-search': ['ai-scenario-judgment', 'agent-evaluation-framework'],
  'snack-selection-agent': ['agent-evaluation-framework', 'dify'],
  'your-world-editor': ['agent-memory-system'],
};

// 按共享标签 + 手动关联匹配相关文章
function getRelatedArticles(projectTags: string[], projectSlug: string, maxResults = 3) {
  const keywords = projectTags
    .flatMap(tag => tag.split(/[·\/,]/).map(k => k.trim()))
    .filter(k => k.length > 1);

  // 自动匹配
  const autoMatched = articles
    .map(article => {
      const searchText = article.title + article.category;
      const score = keywords.filter(kw => searchText.includes(kw)).length;
      return { article, score };
    })
    .filter(s => s.score > 0)
    .sort((a, b) => b.score - a.score)
    .map(s => s.article);

  // 手动关联补充（去重）
  const manualSlugs = MANUAL_CROSSLINKS[projectSlug] || [];
  const manualArticles = manualSlugs
    .map(s => articles.find(a => a.slug === s))
    .filter(Boolean) as typeof articles;

  const merged = [...autoMatched];
  for (const ma of manualArticles) {
    if (!merged.find(a => a.slug === ma.slug)) {
      merged.push(ma);
    }
  }

  return merged.slice(0, maxResults);
}

export async function getStaticPaths() {
  const { projects } = await import('../../data/projects');
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { slug } = Astro.params;
const project = getProjectBySlug(slug);
const { prev, next } = getAdjacentProjects(slug);

if (!project) {
  return Astro.redirect('/404');
}

const relatedArticles = getRelatedArticles(project.tags, slug);

// 其他项目（当前项目以外的导航入口）
const otherProjects = projects.filter(p => p.slug !== slug);

// 封面图映射
const coverImages: Record<string, string> = {
  'your-world-editor': '/images/projects/1封面面板.jpg',
  'snack-selection-agent': '/images/projects/1-封面-数据面板.jpg',
  'tax-policy-search': '/images/projects/1封面-搜索面板.jpg',
};

// 产品架构图映射
const architectureImages: Record<string, string> = {
  'your-world-editor': '/images/projects/your-world-editor-架构图（+案例）.png',
  'snack-selection-agent': '/images/projects/snack-selection-agent-架构图.jpg',
  'tax-policy-search': '/images/projects/tax-policy-search-架构图.jpg',
};

// 截图集映射
const screenshotSets: Record<string, { src: string; label: string }[]> = {
  'your-world-editor': [
    { src: '/images/projects/1封面面板.jpg', label: '对话面板' },
    { src: '/images/projects/2数据看板+情绪窗格.jpg', label: '数据看板与情绪窗格' },
    { src: '/images/projects/3分模块分析面板.jpg', label: '分模块分析面板' },
    { src: '/images/projects/4决策推演.jpg', label: '决策推演' },
  ],
  'snack-selection-agent': [
    { src: '/images/projects/1-封面-数据面板.jpg', label: '数据看板与聊天' },
    { src: '/images/projects/2-智能客服提供完整选品方案.jpg', label: '智能客服选品方案' },
    { src: '/images/projects/促销策略分析.jpg', label: '促销策略分析' },
    { src: '/images/projects/品类洞察.jpg', label: '品类洞察' },
    { src: '/images/projects/3-差评归因.jpg', label: '差评归因分析' },
    { src: '/images/projects/prompt配置.jpg', label: 'Prompt 配置面板' },
  ],
  'tax-policy-search': [
    { src: '/images/projects/1封面-搜索面板.jpg', label: '搜索引擎界面' },
    { src: '/images/projects/2智能引导.jpg', label: '智能引导面板' },
    { src: '/images/projects/3法规原文.jpg', label: '法规原文展示' },
    { src: '/images/projects/4-多标签解读.jpg', label: '多标签解读弹窗' },
  ],
};

// 构建目录结构（与页面区块对应）
const tocSections = [
  { id: 'sec-bg', label: '项目背景' },
  { id: 'sec-problem', label: '核心问题' },
  { id: 'sec-features', label: '功能定义' },
  { id: 'sec-implementation', label: '实现路径' },
];
if (project.beforeAfter.length > 0) {
  tocSections.push({ id: 'sec-results', label: '结果与提升' });
}
if (screenshotSets[slug]) {
  tocSections.push({ id: 'sec-screenshots', label: '产品截图' });
}
tocSections.push({ id: 'sec-architecture', label: '产品架构' });
if (project.demoUrl) {
  tocSections.push({ id: 'sec-demo', label: '在线 Demo' });
}
tocSections.push({ id: 'sec-three-questions', label: '产品三问' });
---

<BaseLayout title={project.title} description={project.description}>
  <!-- 封面区 -->
  <section class="relative">
    <div class:list={["w-full h-[50vh] min-h-[400px] relative overflow-hidden", slug === 'tax-policy-search' ? 'bg-white' : 'bg-blueprint-500/[0.04]']}>
      {
        coverImages[slug] && (
          <img src={coverImages[slug]} alt={project.title} class:list={["w-full h-full", slug === 'tax-policy-search' ? 'object-contain' : 'object-cover object-top']} />
        )
      }
      <div class="absolute inset-0 bg-gradient-to-b from-transparent via-transparent/60 to-white"></div>
    </div>

    <!-- 标题信息层 -->
    <div class="absolute bottom-0 left-0 right-0 pb-12">
      <div class="max-w-4xl mx-auto px-6 lg:px-8">
        <div class="animate-fade-in-up">
          <span class="text-sm font-mono-code text-blueprint-600 tracking-wide">
            {project.subtitle}
          </span>
          <h1 class="font-serif-display text-3xl sm:text-4xl lg:text-5xl font-bold text-charcoal-900 mt-2 mb-4">
            {project.title}
          </h1>
          <div class="flex flex-wrap gap-2">
            {project.tags.map((tag) => (
              <span class="px-3 py-1 text-xs rounded-full border border-blueprint-600/20 text-blueprint-600">{tag}</span>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 项目详情内容 -->
  <section class="py-16 lg:py-20">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <!-- 桌面端：flex 布局，TOC 在左，内容在右 -->
      <div class="lg:flex lg:gap-8 lg:items-start">
        <StickyToc sections={tocSections} title="本页目录" />

        <!-- 内容主体 -->
        <div class="flex-1 min-w-0 max-w-4xl" data-pagefind-body data-pagefind-weight="high">

          <!-- 项目信息栏：角色 + 时间 -->
      <div class="flex flex-wrap gap-6 mb-12 animate-on-scroll animate-fade-in-up">
        <div class="flex items-center gap-2 text-sm text-charcoal-800/70">
          <svg class="w-4 h-4 text-blueprint-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
          </svg>
          {project.role}
        </div>
        <div class="flex items-center gap-2 text-sm text-charcoal-800/70">
          <svg class="w-4 h-4 text-blueprint-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
          {project.timeline}
        </div>
      </div>

      <!-- 一、背景 -->
      <div id="sec-bg" class="mb-16 animate-on-scroll animate-fade-in-up">
        <h2 class="font-serif-display text-2xl font-bold text-charcoal-900 mb-6 flex items-center">
          <span class="w-8 h-0.5 bg-blueprint-600 mr-3"></span>
          项目背景
        </h2>
        <p class="text-xs font-mono-code text-blueprint-600/70 mb-4 tracking-wide">为什么会有这个产品</p>
        <div class="space-y-4">
          {project.background.split(/\n+/).map((para) => (
            <p class="text-sm text-charcoal-800/80 leading-relaxed">
              {para}
            </p>
          ))}
        </div>
      </div>

      <!-- 二、问题 -->
      <div id="sec-problem" class="mb-16 animate-on-scroll animate-fade-in-up">
        <h2 class="font-serif-display text-2xl font-bold text-charcoal-900 mb-6 flex items-center">
          <span class="w-8 h-0.5 bg-blueprint-600 mr-3"></span>
          核心问题
        </h2>
        <p class="text-xs font-mono-code text-blueprint-600/70 mb-4 tracking-wide">需要解决什么问题</p>
        <div class="space-y-3">
          {project.problem.split(/\n+/).map((para) => (
            <p class="text-sm text-charcoal-800/80 leading-relaxed">
              {para}
            </p>
          ))}
        </div>
      </div>

      <!-- 分隔线 -->
      <div class="decorative-line my-12"></div>

      <!-- 三、功能定义 -->
      <div id="sec-features" class="mb-16 animate-on-scroll animate-fade-in-up">
        <h2 class="font-serif-display text-2xl font-bold text-charcoal-900 mb-2 text-center">
          功能定义
        </h2>
        <p class="text-xs font-mono-code text-blueprint-600/70 mb-8 text-center tracking-wide">因此定义什么功能</p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          {project.coreFeatures.map((feature, index) => (
            <div class="p-6 rounded-xl border border-blueprint-600/10 bg-white card-hover">
              <div class="flex flex-col">
                <div class="flex items-start mb-3">
                  <span class="w-8 h-8 rounded-lg bg-blueprint-500/10 text-blueprint-700 flex items-center justify-center font-mono-code text-sm font-bold mr-3 flex-shrink-0 mt-0.5">
                    {String(index + 1).padStart(2, '0')}
                  </span>
                  <h3 class="font-serif-display text-base font-bold text-charcoal-900">
                    {feature.title}
                  </h3>
                </div>
                <div class="space-y-1">
                  {feature.desc.split(/\n+/).map((line) => (
                    <p class="text-sm text-charcoal-800/80 leading-relaxed">{line}</p>
                  ))}
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- 四、实现路径 -->
      <div id="sec-implementation" class="mb-16 animate-on-scroll animate-fade-in-up">
        <h2 class="font-serif-display text-2xl font-bold text-charcoal-900 mb-6 flex items-center">
          <span class="w-8 h-0.5 bg-blueprint-600 mr-3"></span>
          实现路径
        </h2>
        <p class="text-xs font-mono-code text-blueprint-600/70 mb-4 tracking-wide">如何实现</p>
        <div class="space-y-3">
          {project.implementation.split(/\n+/).map((para) => (
            <p class="text-sm text-charcoal-800/80 leading-relaxed">
              {para}
            </p>
          ))}
        </div>
      </div>

      <!-- 五、前后对比 -->
      {project.beforeAfter.length > 0 && (
        <div id="sec-results" class="mb-16 animate-on-scroll animate-fade-in-up">
          <h2 class="font-serif-display text-2xl font-bold text-charcoal-900 mb-2 text-center">
            结果与提升
          </h2>
          <p class="text-xs font-mono-code text-blueprint-600/70 mb-8 text-center tracking-wide">之前 vs 之后</p>
          <div class="overflow-x-auto">
            <table class="w-full text-sm border-collapse">
              <thead>
                <tr class="border-b border-charcoal-900/20">
                  <th class="text-left py-3 px-4 font-medium text-charcoal-900 w-1/5">维度</th>
                  <th class="text-left py-3 px-4 font-medium text-charcoal-800/60 w-2/5">之前</th>
                  <th class="text-left py-3 px-4 font-medium text-blueprint-600 w-2/5">之后</th>
                </tr>
              </thead>
              <tbody>
                {project.beforeAfter.map((item) => (
                  <tr class="border-b border-charcoal-900/10">
                    <td class="py-3 px-4 font-medium text-charcoal-900">{item.dimension}</td>
                    <td class="py-3 px-4 text-charcoal-800/60">{item.before}</td>
                    <td class="py-3 px-4 text-blueprint-600">{item.after}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      )}

      <!-- 数据成果 -->
      <div class="mb-16 animate-on-scroll animate-fade-in-up">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
          {project.results.map((result, index) => (
            <div key={index} class="text-center p-6 rounded-xl bg-gradient-to-br from-blueprint-500/[0.04] to-transparent border border-blueprint-600/15">
              <div class="font-mono-code text-3xl lg:text-4xl font-bold text-blueprint-600 mb-2">
                {result.value}<span class="text-lg">{result.suffix || ''}</span>
              </div>
              <div class="text-sm text-charcoal-800/70">
                {result.label}
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- 分隔线 -->
      <div class="decorative-line my-12"></div>

      <!-- 产品截图集 -->
      {
        screenshotSets[slug] && (
          <div id="sec-screenshots" class="mb-16 animate-on-scroll animate-fade-in-up">
            <h2 class="font-serif-display text-2xl font-bold text-charcoal-900 mb-8 text-center">
              产品截图
            </h2>
            <div class:list={["grid grid-cols-1 sm:grid-cols-2 gap-4", screenshotSets[slug].length <= 4 ? 'lg:grid-cols-2' : 'lg:grid-cols-3']}>
              {screenshotSets[slug].map((ss) => (
                <div class="rounded-xl overflow-hidden border border-blueprint-600/10 bg-white card-hover">
                  <div class="h-48 flex items-center justify-center bg-blueprint-500/[0.04]">
                    <img src={ss.src} alt={ss.label} class="w-full h-full object-contain p-2" loading="lazy" />
                  </div>
                  <p class="text-xs text-center text-charcoal-800/60 py-2">{ss.label}</p>
                </div>
              ))}
            </div>
          </div>
        )
      }

      <!-- 产品架构 -->
      <div id="sec-architecture" class="mb-16 animate-on-scroll animate-fade-in-up">
        <h2 class="font-serif-display text-2xl font-bold text-charcoal-900 mb-6 text-center">
          产品架构
        </h2>
        <div class="w-full rounded-xl border border-blueprint-600/10 bg-white overflow-hidden">
          {
            architectureImages[slug] && (
              <img src={architectureImages[slug]} alt={`${project.title} 产品架构图`} class="w-full h-auto object-contain" loading="lazy" />
            )
          }
        </div>
        <p class="text-sm text-charcoal-800/80 leading-relaxed max-w-2xl mx-auto mt-6 text-center">
          {project.architecture}
        </p>
      </div>

      <!-- Demo 嵌入 -->
      {project.demoUrl && (
        <div id="sec-demo" class="mb-16 animate-on-scroll animate-fade-in-up">
          <h2 class="font-serif-display text-2xl font-bold text-charcoal-900 mb-6 text-center">
            在线 Demo
          </h2>
          <div class="p-8 rounded-xl border-2 border-dashed border-blueprint-600/30 bg-blueprint-500/[0.04]/50 text-center">
            <svg class="w-10 h-10 mx-auto mb-3 text-blueprint-600/50" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <a href={project.demoUrl} target="_blank" rel="noopener" class="text-blueprint-600 hover:text-blueprint-700 font-medium">
              打开 Demo → {project.demoUrl}
            </a>
          </div>
        </div>
      )}

      <!-- 分隔线 -->
      <div class="decorative-line my-12"></div>

      <!-- 产品三问 -->
      <div id="sec-three-questions" class="animate-on-scroll animate-fade-in-up">
        <h2 class="font-serif-display text-2xl font-bold text-charcoal-900 mb-8 text-center">
          产品三问
        </h2>
        <div class="space-y-6">
          <div class="p-6 rounded-xl border-l-4 border-blueprint-600 bg-white">
            <h3 class="font-medium text-charcoal-900 mb-2 flex items-center">
              <span class="w-6 h-6 rounded-full bg-blueprint-600 text-white text-xs flex items-center justify-center mr-3">Q1</span>
              我做了什么判断？
            </h3>
            <p class="text-sm text-charcoal-800/80 leading-relaxed pl-9">
              {project.threeQuestions.what}
            </p>
          </div>
          <div class="p-6 rounded-xl border-l-4 border-blueprint-500 bg-white">
            <h3 class="font-medium text-charcoal-900 mb-2 flex items-center">
              <span class="w-6 h-6 rounded-full bg-blueprint-500/[0.04]0 text-white text-xs flex items-center justify-center mr-3">Q2</span>
              为什么这么判断？
            </h3>
            <p class="text-sm text-charcoal-800/80 leading-relaxed pl-9">
              {project.threeQuestions.why}
            </p>
          </div>
          <div class="p-6 rounded-xl border-l-4 border-blueprint-700 bg-white">
            <h3 class="font-medium text-charcoal-900 mb-2 flex items-center">
              <span class="w-6 h-6 rounded-full bg-blueprint-700 text-white text-xs flex items-center justify-center mr-3">Q3</span>
              如果再做一次会改什么？
            </h3>
            <p class="text-sm text-charcoal-800/80 leading-relaxed pl-9">
              {project.threeQuestions.whatIf}
            </p>
          </div>
        </div>
      </div>
    </div><!-- /.content-main -->
  </div><!-- /.flex -->
</div><!-- /.container -->
  </section>

  <!-- 相关文章（按共享标签 + 手动关联匹配） -->
  {relatedArticles.length > 0 && (
    <section class="py-16 bg-blueprint-500/[0.02] border-t border-blueprint-500/10">
      <div class="max-w-4xl mx-auto px-6 lg:px-8">
        <div class="animate-on-scroll animate-fade-in-up">
          <div class="flex items-center gap-3 mb-8">
            <span class="cad-badge">RELATED</span>
            <span class="text-[10px] font-mono-code text-blueprint-500/30">相关文章</span>
            <div class="flex-1 h-px bg-blueprint-500/10"></div>
          </div>
          <h2 class="font-serif-display text-2xl font-bold text-charcoal-900 mb-6">
            相关思考
          </h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            {relatedArticles.map((article) => (
              <a href={`/thinking/${article.slug}`}
                class="group p-5 rounded-sm border border-blueprint-500/10 bg-white hover:border-blueprint-500/30 transition-all card-hover">
                <span class="text-[10px] font-mono-code px-2 py-0.5 rounded-sm bg-blueprint-500/10 text-blueprint-600">
                  {article.category}
                </span>
                <h3 class="font-serif-display text-base font-bold text-charcoal-900 mt-3 mb-2 group-hover:text-blueprint-500 transition-colors">
                  {article.title}
                </h3>
                <p class="text-xs text-charcoal-800/60 leading-relaxed line-clamp-2">
                  {article.excerpt}
                </p>
                <div class="mt-3 flex items-center text-[10px] text-blueprint-500/70 font-mono-code">
                  {article.date}
                  <span class="mx-2">·</span>
                  {article.readTime}
                </div>
              </a>
            ))}
          </div>

          <!-- 思考页入口：始终展示，引导用户浏览全部文章 -->
          <div class="mt-8 pt-6 border-t border-blueprint-500/10 text-center">
            <a href="/thinking" class="cad-btn cad-btn-secondary text-xs inline-flex items-center gap-2">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
              </svg>
              浏览全部思考文章
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </a>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- 上一个/下一个项目导航 -->
  <section class="py-12 border-t border-blueprint-600/10">
    <div class="max-w-4xl mx-auto px-6 lg:px-8">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {prev ? (
          <a href={`/projects/${prev.slug}`} class="group p-6 rounded-xl border border-blueprint-600/10 hover:border-blueprint-600/30 transition-all card-hover">
            <div class="flex items-center text-sm text-blueprint-600 mb-2">
              <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
              </svg>
              上一个项目
            </div>
            <h4 class="font-serif-display font-bold text-charcoal-900 group-hover:text-blueprint-600 transition-colors">
              {prev.title}
            </h4>
          </a>
        ) : <div></div>}
        {next ? (
          <a href={`/projects/${next.slug}`} class="group p-6 rounded-xl border border-blueprint-600/10 hover:border-blueprint-600/30 transition-all card-hover text-right">
            <div class="flex items-center justify-end text-sm text-blueprint-600 mb-2">
              下一个项目
              <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </div>
            <h4 class="font-serif-display font-bold text-charcoal-900 group-hover:text-blueprint-600 transition-colors">
              {next.title}
            </h4>
          </a>
        ) : <div></div>}
      </div>
    </div>
  </section>

  <!-- 右侧固定项目导航（桌面端） -->
  <div class="fixed right-0 top-1/2 -translate-y-1/2 z-40 hidden lg:flex flex-col items-end gap-1.5 pointer-events-none">
    <span class="text-[9px] font-mono-code text-charcoal-800/30 tracking-widest pr-4 mb-0.5">PROJECTS</span>
    {otherProjects.map((p) => (
      <a href={`/projects/${p.slug}`}
        class="pointer-events-auto group flex items-center gap-2 pl-2.5 pr-2 py-1.5 rounded-l-sm border border-r-0 border-blueprint-500/10 bg-white/90 backdrop-blur-sm hover:bg-blueprint-500/5 hover:border-blueprint-500/30 transition-all text-right">
        <span class="text-[11px] font-medium text-charcoal-800/50 group-hover:text-blueprint-600 transition-colors whitespace-nowrap">{p.title}</span>
        <svg class="w-3 h-3 text-blueprint-600/30 group-hover:text-blueprint-600 transition-colors flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </a>
    ))}
  </div>
</BaseLayout>
