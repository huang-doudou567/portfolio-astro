---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getProjectBySlug, getAdjacentProjects } from '../../data/projects';

export async function getStaticPaths() {
  const { projects } = await import('../../data/projects');
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { slug } = Astro.params;
const project = getProjectBySlug(slug);
const { prev, next } = getAdjacentProjects(slug);

if (!project) {
  return Astro.redirect('/404');
}

// 封面图映射
const coverImages: Record<string, string> = {
  'your-world-editor': '/images/projects/1封面面板.jpg',
  'snack-selection-agent': '/images/projects/1-封面-数据面板.jpg',
  'tax-policy-search': '/images/projects/1封面-搜索面板.jpg',
};

// 截图集映射
const screenshotSets: Record<string, { src: string; label: string }[]> = {
  'your-world-editor': [
    { src: '/images/projects/2数据看板+情绪窗格.jpg', label: '数据看板与情绪窗格' },
    { src: '/images/projects/3分模块分析面板.jpg', label: '分模块分析面板' },
    { src: '/images/projects/4决策推演.jpg', label: '决策推演' },
  ],
  'snack-selection-agent': [
    { src: '/images/projects/2-智能客服提供完整选品方案.jpg', label: '智能客服选品方案' },
    { src: '/images/projects/促销策略分析.jpg', label: '促销策略分析' },
    { src: '/images/projects/品类洞察.jpg', label: '品类洞察' },
    { src: '/images/projects/3-差评归因.jpg', label: '差评归因分析' },
    { src: '/images/projects/prompt配置.jpg', label: 'Prompt 配置面板' },
  ],
  'tax-policy-search': [
    { src: '/images/projects/2智能引导.jpg', label: '智能引导面板' },
    { src: '/images/projects/3法规原文.jpg', label: '法规原文展示' },
    { src: '/images/projects/4-多标签解读.jpg', label: '多标签解读弹窗' },
  ],
};
---

<BaseLayout title={project.title} description={project.description}>
  <!-- 封面区 -->
  <section class="relative">
    <div class:list={["w-full h-[50vh] min-h-[400px] relative overflow-hidden", slug === 'tax-policy-search' ? 'bg-white' : 'bg-charcoal-900/5 dark:bg-cream-100/5']}>
      {
        coverImages[slug] && (
          <img src={coverImages[slug]} alt={project.title} class:list={["w-full h-full", slug === 'tax-policy-search' ? 'object-contain' : 'object-cover object-top']} />
        )
      }
      <div class="absolute inset-0 bg-gradient-to-b from-transparent via-transparent/60 to-cream-100 dark:to-dark-bg-950"></div>
    </div>

    <!-- 标题信息层 -->
    <div class="absolute bottom-0 left-0 right-0 pb-12">
      <div class="max-w-4xl mx-auto px-6 lg:px-8">
        <div class="animate-fade-in-up">
          <span class="text-sm font-mono-code text-ochre-500 tracking-wide">
            {project.subtitle}
          </span>
          <h1 class="font-serif-display text-3xl sm:text-4xl lg:text-5xl font-bold text-charcoal-900 dark:text-cream-100 mt-2 mb-4">
            {project.title}
          </h1>
          <div class="flex flex-wrap gap-2">
            {project.tags.map((tag) => (
              <span class="tag text-ochre-600 dark:text-ochre-400">{tag}</span>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 项目详情内容 -->
  <section class="py-16 lg:py-20">
    <div class="max-w-4xl mx-auto px-6 lg:px-8">
      <!-- 项目背景 & 我的角色 -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-16 animate-on-scroll animate-fade-in-up">
        <div>
          <h2 class="font-serif-display text-xl font-bold text-charcoal-900 dark:text-cream-100 mb-4 flex items-center">
            <span class="w-8 h-0.5 bg-ochre-500 mr-3"></span>
            项目背景
          </h2>
          {
            project.background.split('\n\n').map((para, i) => (
              <p class:list={["text-charcoal-800/80 dark:text-cream-100/80 leading-relaxed text-sm", i > 0 ? "mt-3" : ""]}>
                {para}
              </p>
            ))
          }
        </div>
        <div>
          <h2 class="font-serif-display text-xl font-bold text-charcoal-900 dark:text-cream-100 mb-4 flex items-center">
            <span class="w-8 h-0.5 bg-ochre-500 mr-3"></span>
            我的角色
          </h2>
          <div class="space-y-3">
            <div class="flex items-start">
              <svg class="w-5 h-5 text-ochre-500 mt-0.5 mr-3 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
              </svg>
              <div>
                <p class="text-sm font-medium text-charcoal-900 dark:text-cream-100">职责</p>
                <p class="text-sm text-charcoal-800/70 dark:text-cream-100/70">{project.role}</p>
              </div>
            </div>
            <div class="flex items-start">
              <svg class="w-5 h-5 text-ochre-500 mt-0.5 mr-3 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
              <div>
                <p class="text-sm font-medium text-charcoal-900 dark:text-cream-100">时间</p>
                <p class="text-sm text-charcoal-800/70 dark:text-cream-100/70">{project.timeline}</p>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- 分隔线 -->
      <div class="decorative-line my-12"></div>

      <!-- 核心功能 -->
      <div class="mb-16 animate-on-scroll animate-fade-in-up">
        <h2 class="font-serif-display text-2xl font-bold text-charcoal-900 dark:text-cream-100 mb-8 text-center">
          核心功能
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          {project.coreFeatures.map((feature, index) => (
            <div class="p-6 rounded-xl border border-charcoal-900/10 dark:border-cream-100/10 bg-cream-50/50 dark:bg-dark-bg-900/50 card-hover">
              <div class="flex flex-col">
                <div class="flex items-center mb-3">
                  <span class="w-8 h-8 rounded-lg bg-ochre-500/10 text-ochre-500 flex items-center justify-center font-mono-code text-sm font-bold mr-3 flex-shrink-0">
                    {String(index + 1).padStart(2, '0')}
                  </span>
                  <h3 class="font-serif-display text-base font-bold text-charcoal-900 dark:text-cream-100">
                    {feature.title}
                  </h3>
                </div>
                <p class="text-sm text-charcoal-800/80 dark:text-cream-100/80 leading-relaxed">
                  {feature.desc}
                </p>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- 产品截图集 -->
      {
        screenshotSets[slug] && (
          <div class="mb-16 animate-on-scroll animate-fade-in-up">
            <h2 class="font-serif-display text-2xl font-bold text-charcoal-900 dark:text-cream-100 mb-8 text-center">
              产品截图
            </h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
              {screenshotSets[slug].map((ss) => (
                <div class="rounded-xl overflow-hidden border border-charcoal-900/10 dark:border-cream-100/10 bg-cream-100 dark:bg-dark-bg-900 card-hover">
                  <div class="h-48 flex items-center justify-center bg-cream-100 dark:bg-dark-bg-900">
                    <img src={ss.src} alt={ss.label} class="w-full h-full object-contain p-2" loading="lazy" />
                  </div>
                  <p class="text-xs text-center text-charcoal-800/60 dark:text-cream-100/60 py-2">{ss.label}</p>
                </div>
              ))}
            </div>
          </div>
        )
      }

      <!-- 产品架构 -->
      <div class="mb-16 animate-on-scroll animate-fade-in-up">
        <h2 class="font-serif-display text-2xl font-bold text-charcoal-900 dark:text-cream-100 mb-6 text-center">
          产品架构
        </h2>
        <div class="w-full min-h-[160px] rounded-xl placeholder-image border border-charcoal-900/10 dark:border-cream-100/10 p-6">
          <div class="text-center px-4">
            <p class="text-sm text-charcoal-800/80 dark:text-cream-100/80 leading-relaxed max-w-2xl mx-auto">
              {project.architecture}
            </p>
            <p class="text-xs text-ochre-500/70 mt-3 italic">可在此处放置产品架构图</p>
          </div>
        </div>
      </div>

      <!-- Demo 嵌入 -->
      {project.demoUrl && (
        <div class="mb-16 animate-on-scroll animate-fade-in-up">
          <h2 class="font-serif-display text-2xl font-bold text-charcoal-900 dark:text-cream-100 mb-6 text-center">
            在线 Demo
          </h2>
          <div class="p-8 rounded-xl border-2 border-dashed border-ochre-500/30 bg-ochre-500/5 text-center">
            <svg class="w-10 h-10 mx-auto mb-3 text-ochre-500/50" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <a href={project.demoUrl} target="_blank" rel="noopener" class="text-ochre-500 hover:text-ochre-600 font-medium">
              打开 Demo → {project.demoUrl}
            </a>
          </div>
        </div>
      )}

      <!-- 数据成果 -->
      <div class="mb-16 animate-on-scroll animate-fade-in-up">
        <h2 class="font-serif-display text-2xl font-bold text-charcoal-900 dark:text-cream-100 mb-8 text-center">
          数据成果
        </h2>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
          {project.results.map((result, index) => (
            <div key={index} class="text-center p-6 rounded-xl bg-gradient-to-br from-ochre-500/10 to-transparent border border-ochre-500/20">
              <div class="font-mono-code text-3xl lg:text-4xl font-bold text-ochre-500 mb-2">
                {result.value}<span class="text-lg">{result.suffix || ''}</span>
              </div>
              <div class="text-sm text-charcoal-800/70 dark:text-cream-100/70">
                {result.label}
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- 分隔线 -->
      <div class="decorative-line my-12"></div>

      <!-- 产品三问 -->
      <div class="animate-on-scroll animate-fade-in-up">
        <h2 class="font-serif-display text-2xl font-bold text-charcoal-900 dark:text-cream-100 mb-8 text-center">
          产品三问
        </h2>
        <div class="space-y-6">
          <div class="p-6 rounded-xl border-l-4 border-ochre-500 bg-cream-50/50 dark:bg-dark-bg-900/50">
            <h3 class="font-medium text-charcoal-900 dark:text-cream-100 mb-2 flex items-center">
              <span class="w-6 h-6 rounded-full bg-ochre-500 text-white text-xs flex items-center justify-center mr-3">Q1</span>
              我做了什么判断？
            </h3>
            <p class="text-sm text-charcoal-800/80 dark:text-cream-100/80 leading-relaxed pl-9">
              {project.threeQuestions.what}
            </p>
          </div>
          <div class="p-6 rounded-xl border-l-4 border-ochre-400 bg-cream-50/50 dark:bg-dark-bg-900/50">
            <h3 class="font-medium text-charcoal-900 dark:text-cream-100 mb-2 flex items-center">
              <span class="w-6 h-6 rounded-full bg-ochre-400 text-white text-xs flex items-center justify-center mr-3">Q2</span>
              为什么这么判断？
            </h3>
            <p class="text-sm text-charcoal-800/80 dark:text-cream-100/80 leading-relaxed pl-9">
              {project.threeQuestions.why}
            </p>
          </div>
          <div class="p-6 rounded-xl border-l-4 border-ochre-600 bg-cream-50/50 dark:bg-dark-bg-900/50">
            <h3 class="font-medium text-charcoal-900 dark:text-cream-100 mb-2 flex items-center">
              <span class="w-6 h-6 rounded-full bg-ochre-600 text-white text-xs flex items-center justify-center mr-3">Q3</span>
              如果再做一次会改什么？
            </h3>
            <p class="text-sm text-charcoal-800/80 dark:text-cream-100/80 leading-relaxed pl-9">
              {project.threeQuestions.whatIf}
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 上一个/下一个项目导航 -->
  <section class="py-12 border-t border-charcoal-900/10 dark:border-cream-100/10">
    <div class="max-w-4xl mx-auto px-6 lg:px-8">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {prev ? (
          <a href={`/projects/${prev.slug}`} class="group p-6 rounded-xl border border-charcoal-900/10 dark:border-cream-100/10 hover:border-ochre-500/50 transition-all card-hover">
            <div class="flex items-center text-sm text-ochre-500 mb-2">
              <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
              </svg>
              上一个项目
            </div>
            <h4 class="font-serif-display font-bold text-charcoal-900 dark:text-cream-100 group-hover:text-ochre-500 transition-colors">
              {prev.title}
            </h4>
          </a>
        ) : <div></div>}
        {next ? (
          <a href={`/projects/${next.slug}`} class="group p-6 rounded-xl border border-charcoal-900/10 dark:border-cream-100/10 hover:border-ochre-500/50 transition-all card-hover text-right">
            <div class="flex items-center justify-end text-sm text-ochre-500 mb-2">
              下一个项目
              <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </div>
            <h4 class="font-serif-display font-bold text-charcoal-900 dark:text-cream-100 group-hover:text-ochre-500 transition-colors">
              {next.title}
            </h4>
          </a>
        ) : <div></div>}
      </div>
    </div>
  </section>
</BaseLayout>
