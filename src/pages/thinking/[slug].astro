---
import BaseLayout from '../../layouts/BaseLayout.astro';
import StickyToc from '../../components/StickyToc.astro';
import { getArticleBySlug, getArticlesByCategory } from '../../data/articles';
import { projects } from '../../data/projects';

// 按关键词匹配相关项目
function getRelatedProjects(articleTitle: string, articleCategory: string, maxResults = 2) {
  const keywords = (articleTitle + articleCategory)
    .split(/[\s,·/]/)
    .filter(k => k.length > 1);

  return projects
    .map(project => {
      const searchText = project.title + project.description + project.tags.join(' ');
      const score = keywords.filter(kw => searchText.includes(kw)).length;
      return { project, score };
    })
    .filter(s => s.score > 0)
    .sort((a, b) => b.score - a.score)
    .slice(0, maxResults)
    .map(s => s.project);
}

export async function getStaticPaths() {
  const { articles } = await import('../../data/articles');
  return articles.map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

const { slug } = Astro.params;
const article = getArticleBySlug(slug);

if (!article) {
  return Astro.redirect('/404');
}

const relatedProjects = getRelatedProjects(article.title, article.category);

// 同类文章（排除当前）
const sameCategoryArticles = getArticlesByCategory(article.category)
  .filter(a => a.slug !== slug)
  .slice(0, 3);

// 从 Markdown 内容中提取目录结构
interface TocItem { id: string; label: string; level: number; }

function slugifyHeading(text: string): string {
  // 转小写、空格变连字符、去除非单词字符（保留中日韩文字）
  return text.trim()
    .replace(/\s+/g, '-')
    .replace(/[^\w一-鿿-]/g, '')
    .toLowerCase();
}

function extractToc(content: string): TocItem[] {
  const toc: TocItem[] = [];
  const lines = content.split('\n');
  for (const line of lines) {
    const h2 = line.match(/^## (.+)/);
    const h3 = line.match(/^### (.+)/);
    if (h2) {
      const text = h2[1].trim();
      toc.push({ id: slugifyHeading(text), label: text, level: 0 });
    } else if (h3) {
      const text = h3[1].trim();
      toc.push({ id: slugifyHeading(text), label: text, level: 1 });
    }
  }
  return toc;
}

const articleToc = extractToc(article.content);

function renderContent(content: string): string {
  // 1) 去掉 ** 号（Markdown 加粗标记 → 纯文本）
  let text = content.replace(/\*\*(.+?)\*\*/g, '$1');

  // 2) 转换 ## / ### 为标题标签
  let html = text
    .replace(/^## (.+)$/gm, (_, heading) => {
      const id = slugifyHeading(heading);
      return `<h2 id="${id}" class="font-serif-display text-2xl font-bold text-charcoal-900 mt-12 mb-4">${heading}</h2>`;
    })
    .replace(/^### (.+)$/gm, (_, heading) => {
      const id = slugifyHeading(heading);
      return `<h3 id="${id}" class="font-serif-display text-xl font-bold text-charcoal-900 mt-8 mb-3">${heading}</h3>`;
    });

  // 3) 按双换行切段落，逐段包装
  const blocks = html.split(/\n\n+/);
  return blocks
    .map(block => {
      const trimmed = block.trim();
      if (!trimmed) return '';
      // 已经是标题标签 → 原样输出
      if (/^<h[23]/.test(trimmed) && /<\/h[23]>$/.test(trimmed)) {
        return trimmed;
      }
      // 普通段落 → 去除残留换行后用 <p> 包裹
      const clean = trimmed.replace(/\n/g, ' ');
      return `<p class="text-charcoal-800/80 leading-relaxed mb-4">${clean}</p>`;
    })
    .join('\n');
}
---

<BaseLayout title={article.title} description={article.excerpt}>
  <section class="py-16 lg:py-20">
    <div class="max-w-3xl mx-auto px-6 lg:px-8">
      <div class="animate-fade-in-up">
        <a href="/thinking" class="inline-flex items-center text-sm text-blueprint-500 hover:text-blueprint-600 mb-6 transition-colors">
          <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
          </svg>
          返回思考列表
        </a>
        <span class="inline-block text-xs font-medium px-3 py-1 rounded-full bg-blueprint-500/10 text-blueprint-600 mb-4">
          {article.category}
        </span>
        <h1 class="font-serif-display text-3xl sm:text-4xl lg:text-5xl font-bold text-charcoal-900 leading-tight mb-6">
          {article.title}
        </h1>
        <div class="flex items-center space-x-4 text-sm text-charcoal-800/60 font-mono-code">
          <span>{article.date}</span>
          <span>·</span>
          <span>{article.readTime} 阅读</span>
        </div>
      </div>
    </div>
  </section>

  <article class="pb-20">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="lg:flex lg:gap-8 lg:items-start">
        <StickyToc sections={articleToc} title="文章目录" />
        <div class="flex-1 min-w-0 max-w-4xl">
      <div class="prose prose-lg max-w-none animate-on-scroll animate-fade-in-up">
        <div class="decorative-line mb-12"></div>
        <div class="article-content space-y-4" data-pagefind-body data-pagefind-weight="high">
          <Fragment set:html={renderContent(article.content)} />
        </div>
        <div class="mt-16 pt-8 border-t border-blueprint-500/10">
          <p class="text-sm text-charcoal-800/50 italic">以上观点基于项目实践中的总结与反思，将持续迭代更新。</p>
        </div>
      </div><!-- /.prose -->
    </div><!-- /.content-main -->
  </div><!-- /.flex -->
</div><!-- /.container -->
  </article>

  <!-- 相关项目（按关键词匹配） -->
  {relatedProjects.length > 0 && (
    <section class="py-16 bg-blueprint-500/[0.02] border-t border-blueprint-500/10">
      <div class="max-w-4xl mx-auto px-6 lg:px-8">
        <div class="animate-on-scroll animate-fade-in-up">
          <div class="flex items-center gap-3 mb-8">
            <span class="cad-badge">RELATED</span>
            <span class="text-[10px] font-mono-code text-blueprint-500/30">相关项目</span>
            <div class="flex-1 h-px bg-blueprint-500/10"></div>
          </div>
          <h2 class="font-serif-display text-2xl font-bold text-charcoal-900 mb-6">
            相关项目
          </h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            {relatedProjects.map((project) => (
              <a href={`/projects/${project.slug}`}
                class="group p-5 rounded-sm border border-blueprint-500/10 bg-white hover:border-blueprint-500/30 transition-all card-hover">
                <span class="text-[10px] font-mono-code px-2 py-0.5 rounded-sm bg-blueprint-500/10 text-blueprint-600">
                  {project.subtitle}
                </span>
                <h3 class="font-serif-display text-base font-bold text-charcoal-900 mt-3 mb-2 group-hover:text-blueprint-500 transition-colors">
                  {project.title}
                </h3>
                <p class="text-xs text-charcoal-800/60 leading-relaxed line-clamp-2">
                  {project.description}
                </p>
              </a>
            ))}
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- 同类文章（相同分类的其他思考） -->
  {sameCategoryArticles.length > 0 && (
    <section class="py-16 bg-blueprint-500/[0.02] border-t border-blueprint-500/10">
      <div class="max-w-4xl mx-auto px-6 lg:px-8">
        <div class="animate-on-scroll animate-fade-in-up">
          <div class="flex items-center gap-3 mb-8">
            <span class="cad-badge">{article.category === '产品方法论' ? 'METHODOLOGY' : article.category === '产品拆解' ? 'TEARDOWN' : 'OBSERVATION'}</span>
            <span class="text-[10px] font-mono-code text-blueprint-500/30">同类{article.category}</span>
            <div class="flex-1 h-px bg-blueprint-500/10"></div>
          </div>
          <h2 class="font-serif-display text-2xl font-bold text-charcoal-900 mb-6">
            更多{article.category}
          </h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            {sameCategoryArticles.map((a) => (
              <a href={`/thinking/${a.slug}`}
                class="group p-5 rounded-sm border border-blueprint-500/10 bg-white hover:border-blueprint-500/30 transition-all card-hover">
                <span class="text-[10px] font-mono-code px-2 py-0.5 rounded-sm bg-blueprint-500/10 text-blueprint-600">
                  {a.category}
                </span>
                <h3 class="font-serif-display text-base font-bold text-charcoal-900 mt-3 mb-2 group-hover:text-blueprint-500 transition-colors">
                  {a.title}
                </h3>
                <p class="text-xs text-charcoal-800/60 leading-relaxed line-clamp-2">
                  {a.excerpt}
                </p>
                <div class="mt-3 flex items-center text-[10px] text-blueprint-500/70 font-mono-code">
                  {a.date}
                  <span class="mx-2">·</span>
                  {a.readTime}
                </div>
              </a>
            ))}
          </div>

          <!-- 返回思考列表入口 -->
          <div class="mt-8 pt-6 border-t border-blueprint-500/10 text-center">
            <a href="/thinking" class="cad-btn cad-btn-secondary text-xs inline-flex items-center gap-2">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
              </svg>
              浏览全部思考文章
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </a>
          </div>
        </div>
      </div>
    </section>
  )}

  <section class="py-16 border-t border-blueprint-500/10">
    <div class="max-w-3xl mx-auto px-6 lg:px-8">
      <h3 class="font-serif-display text-xl font-bold text-charcoal-900 mb-6">继续阅读</h3>
      <div class="flex justify-between">
        <a href="/thinking" class="btn-secondary text-sm">查看全部文章</a>
        <a href="/projects" class="text-sm text-blueprint-500 hover:text-blueprint-600 font-medium inline-flex items-center">
          看看项目作品
          <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .article-content h2 {
    font-family: Georgia, Cambria, "Times New Roman", Times, serif;
    font-size: 1.5rem;
    font-weight: bold;
    color: inherit;
    margin-top: 3rem;
    margin-bottom: 1rem;
  }
  .article-content h3 {
    font-family: Georgia, Cambria, "Times New Roman", Times, serif;
    font-size: 1.25rem;
    font-weight: bold;
    color: inherit;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }
  .article-content p {
    line-height: 1.8;
    margin-bottom: 1rem;
  }
</style>
