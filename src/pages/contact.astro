---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="联系" description="联系方式">
  <section class="min-h-[70vh] flex items-center py-16">
    <div class="max-w-3xl mx-auto px-6 lg:px-8 w-full">
      <div class="text-center animate-fade-in-up">
        <span class="text-sm font-mono-code text-blueprint-500 tracking-widest uppercase">Get in Touch</span>
        <h1 class="font-serif-display text-4xl lg:text-5xl font-bold text-charcoal-900 mt-3 mb-6">
          联系我
        </h1>
        <p class="text-lg text-charcoal-800/70 max-w-xl mx-auto mb-12">
          无论是合作机会、职业邀约，还是单纯想聊聊 AI 产品，都欢迎随时联系。
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 mb-12">
        <div class="animate-on-scroll animate-fade-in-up animate-delay-100">
          <a href="mailto:maravillosokk@163.com" class="block h-full p-8 rounded-2xl border border-blueprint-500/10 bg-white card-hover group">
            <div class="w-12 h-12 rounded-xl bg-blueprint-100 flex items-center justify-center mb-4 group-hover:bg-blueprint-200 transition-colors">
              <svg class="w-6 h-6 text-blueprint-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            </div>
            <h3 class="font-serif-display text-lg font-bold text-charcoal-900 mb-2 group-hover:text-blueprint-500 transition-colors">邮箱</h3>
            <p class="text-sm text-charcoal-800/70 font-mono-code break-all">maravillosokk@163.com</p>
          </a>
        </div>

        <div class="animate-on-scroll animate-fade-in-up animate-delay-200">
          <a href="https://github.com/huang-doudou567" target="_blank" rel="noopener" class="block h-full p-8 rounded-2xl border border-blueprint-500/10 bg-white card-hover group">
            <div class="w-12 h-12 rounded-xl bg-blueprint-100 flex items-center justify-center mb-4 group-hover:bg-blueprint-200 transition-colors">
              <svg class="w-6 h-6 text-blueprint-600" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
              </svg>
            </div>
            <h3 class="font-serif-display text-lg font-bold text-charcoal-900 mb-2 group-hover:text-blueprint-500 transition-colors">GitHub</h3>
            <p class="text-sm text-charcoal-800/70 font-mono-code">@huang-doudou567</p>
          </a>
        </div>

        <div class="animate-on-scroll animate-fade-in-up animate-delay-300">
          <div class="block h-full p-8 rounded-2xl border border-blueprint-500/10 bg-white card-hover group">
            <div class="w-12 h-12 rounded-xl bg-blueprint-100 flex items-center justify-center mb-4 group-hover:bg-blueprint-200 transition-colors">
              <svg class="w-6 h-6 text-blueprint-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
              </svg>
            </div>
            <h3 class="font-serif-display text-lg font-bold text-charcoal-900 mb-2 group-hover:text-blueprint-500 transition-colors">微信</h3>
            <p class="text-sm text-charcoal-800/70 font-mono-code">Maravilloso_</p>
          </div>
        </div>
      </div>

      <!-- 简历下载 -->
      <div class="animate-on-scroll animate-fade-in-up animate-delay-400">
        <div class="bg-gradient-to-br from-blueprint-50 to-blueprint-100/50 rounded-3xl p-8 lg:p-10 border border-blueprint-500/15 text-center relative overflow-hidden">
          <div class="absolute top-0 right-0 w-48 h-48 bg-blueprint-500/5 rounded-full blur-3xl -translate-y-1/2 translate-x-1/2"></div>
          <div class="relative z-10">
            <div class="w-16 h-16 rounded-2xl bg-blueprint-500 flex items-center justify-center mx-auto mb-5 shadow-lg shadow-blueprint-500/20">
              <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
              </svg>
            </div>
            <h3 class="font-serif-display text-xl font-bold text-charcoal-900 mb-2">下载我的简历</h3>
            <p class="text-sm text-charcoal-800/70 mb-6 max-w-md mx-auto">PDF 格式，包含完整的工作经历、项目经验与技能详情</p>
            <a href="/resume.pdf" download class="inline-flex items-center px-8 py-3.5 bg-blueprint-500 text-white font-medium rounded-xl hover:bg-blueprint-600 transition-all hover:-translate-y-0.5 hover:shadow-xl hover:shadow-blueprint-500/20">
              <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
              </svg>
              下载简历 PDF
            </a>
          </div>
        </div>
      </div>

      <div class="animate-on-scroll animate-fade-in-up animate-delay-500 mt-12 text-center">
        <p class="text-charcoal-800/60 text-sm">期待与你的交流 ✨</p>
        <p class="text-charcoal-800/40 text-xs mt-2 font-mono-code">通常会在 24 小时内回复</p>
      </div>
    </div>
  </section>
</BaseLayout>
